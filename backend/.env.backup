# Database Configuration (Local Development)
DATABASE_URL=postgresql://english_assistant:english_password@localhost:5432/english_assistant

# Zhipu AI Configuration
# Get your API key from: https://open.bigmodel.cn/usercenter/apikeys

# JWT Configuration
SECRET_KEY=change-this-secret-key-in-production-use-os-urandom
JWT_SECRET_KEY=change-this-secret-key-in-production-use-os-urandom
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=True

# Rate Limiting
RATE_LIMIT_ANONYMOUS=5/hour
RATE_LIMIT_FREE=50/day
RATE_LIMIT_PAID=500/day

# Cache (V1 MVP uses in-memory cache)
CACHE_ENABLED=True
CACHE_TTL=86400
CACHE_MAX_SIZE=1000

# File Upload
MAX_TEXT_LENGTH=5000
MAX_FILE_SIZE=10485760

# LanguageTool
LANGUAGETOOL_LANGUAGE=en-US
LANGUAGETOOL_MAX_ERRORS=100
